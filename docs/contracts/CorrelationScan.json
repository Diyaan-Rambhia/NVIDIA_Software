{
  "$defs": {
    "ContagionHypothesis": {
      "additionalProperties": false,
      "description": "Qualitative contagion hypothesis item.",
      "properties": {
        "evidence_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ids"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "ContagionHypothesis",
      "type": "object"
    },
    "ContagionNews": {
      "additionalProperties": false,
      "description": "External macro news container with real execution state.",
      "properties": {
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "error_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Status"
        },
        "not_run_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Run Reason"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "results": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/NewsArticle"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Results"
        },
        "state": {
          "default": "not_run",
          "title": "State",
          "type": "string"
        }
      },
      "title": "ContagionNews",
      "type": "object"
    },
    "NewsArticle": {
      "additionalProperties": false,
      "description": "External news article carrying evidence identifier.",
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "content"
      ],
      "title": "NewsArticle",
      "type": "object"
    },
    "ShiftedPair": {
      "additionalProperties": false,
      "description": "Pair correlation shift detail.",
      "properties": {
        "baseline_corr": {
          "title": "Baseline Corr",
          "type": "number"
        },
        "current_corr": {
          "title": "Current Corr",
          "type": "number"
        },
        "fr_adjusted_corr": {
          "title": "Fr Adjusted Corr",
          "type": "number"
        },
        "p_value": {
          "title": "P Value",
          "type": "number"
        },
        "pair": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Pair",
          "type": "array"
        },
        "q_value": {
          "title": "Q Value",
          "type": "number"
        }
      },
      "required": [
        "pair",
        "baseline_corr",
        "current_corr",
        "fr_adjusted_corr",
        "p_value",
        "q_value"
      ],
      "title": "ShiftedPair",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output contract for Feature 1 correlation scan per PROJECT.md \u00a75.7 and \u00a75.8.",
  "properties": {
    "absorption_ratio": {
      "title": "Absorption Ratio",
      "type": "number"
    },
    "ar_delta_std": {
      "title": "Ar Delta Std",
      "type": "number"
    },
    "as_of": {
      "title": "As Of",
      "type": "string"
    },
    "code_version": {
      "title": "Code Version",
      "type": "string"
    },
    "episodes_status": {
      "default": "pending_scan_full_history",
      "title": "Episodes Status",
      "type": "string"
    },
    "hypotheses": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ContagionHypothesis"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hypotheses"
    },
    "matrix_summary": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          }
        ]
      },
      "title": "Matrix Summary",
      "type": "object"
    },
    "mean_correlation": {
      "title": "Mean Correlation",
      "type": "number"
    },
    "news": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContagionNews"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameters_used": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Parameters Used",
      "type": "object"
    },
    "regime_flag": {
      "title": "Regime Flag",
      "type": "string"
    },
    "scan_duration_seconds": {
      "default": 0.0,
      "title": "Scan Duration Seconds",
      "type": "number"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "significant_pairs_count": {
      "title": "Significant Pairs Count",
      "type": "integer"
    },
    "source_label": {
      "default": "market data, third-party, delayed",
      "title": "Source Label",
      "type": "string"
    },
    "top_shifted_pairs": {
      "items": {
        "$ref": "#/$defs/ShiftedPair"
      },
      "title": "Top Shifted Pairs",
      "type": "array"
    }
  },
  "required": [
    "as_of",
    "parameters_used",
    "regime_flag",
    "absorption_ratio",
    "ar_delta_std",
    "significant_pairs_count",
    "mean_correlation",
    "seed",
    "code_version"
  ],
  "title": "CorrelationScan",
  "type": "object"
}
