{
  "$defs": {
    "BenchmarkReplay": {
      "additionalProperties": false,
      "description": "Cash flow replay into a benchmark series.",
      "properties": {
        "benchmark_name": {
          "title": "Benchmark Name",
          "type": "string"
        },
        "partial_shortfall": {
          "default": false,
          "title": "Partial Shortfall",
          "type": "boolean"
        },
        "terminal_value": {
          "title": "Terminal Value",
          "type": "number"
        },
        "xirr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xirr"
        }
      },
      "required": [
        "benchmark_name",
        "terminal_value"
      ],
      "title": "BenchmarkReplay",
      "type": "object"
    },
    "InstitutionalMetrics": {
      "additionalProperties": false,
      "description": "Institutional relative performance metrics.",
      "properties": {
        "alpha": {
          "title": "Alpha",
          "type": "number"
        },
        "beta": {
          "title": "Beta",
          "type": "number"
        },
        "information_ratio": {
          "title": "Information Ratio",
          "type": "number"
        },
        "tracking_error": {
          "title": "Tracking Error",
          "type": "number"
        }
      },
      "required": [
        "beta",
        "alpha",
        "tracking_error",
        "information_ratio"
      ],
      "title": "InstitutionalMetrics",
      "type": "object"
    },
    "Portfolio": {
      "additionalProperties": false,
      "description": "Aggregated portfolio positions and valuations.",
      "properties": {
        "cash_balance": {
          "default": 0.0,
          "title": "Cash Balance",
          "type": "number"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/Position"
          },
          "title": "Positions",
          "type": "array"
        },
        "total_cost": {
          "title": "Total Cost",
          "type": "number"
        },
        "total_market_value": {
          "title": "Total Market Value",
          "type": "number"
        },
        "total_realized_pnl": {
          "title": "Total Realized Pnl",
          "type": "number"
        },
        "total_unrealized_pnl": {
          "title": "Total Unrealized Pnl",
          "type": "number"
        }
      },
      "required": [
        "positions",
        "total_cost",
        "total_market_value",
        "total_realized_pnl",
        "total_unrealized_pnl"
      ],
      "title": "Portfolio",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "Open or closed position summary for a single instrument.",
      "properties": {
        "average_buy_price": {
          "title": "Average Buy Price",
          "type": "number"
        },
        "current_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Price"
        },
        "current_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Value"
        },
        "quantity": {
          "title": "Quantity",
          "type": "number"
        },
        "realized_pnl": {
          "title": "Realized Pnl",
          "type": "number"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "unrealized_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unrealized Pnl"
        }
      },
      "required": [
        "symbol",
        "quantity",
        "average_buy_price",
        "realized_pnl"
      ],
      "title": "Position",
      "type": "object"
    },
    "ProcessMetrics": {
      "additionalProperties": false,
      "description": "Execution and decision process metrics.",
      "properties": {
        "concentration_hhi": {
          "title": "Concentration Hhi",
          "type": "number"
        },
        "disposition_effect": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Disposition Effect",
          "type": "object"
        },
        "max_drawdown": {
          "title": "Max Drawdown",
          "type": "number"
        },
        "process_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Label"
        },
        "turnover": {
          "title": "Turnover",
          "type": "number"
        }
      },
      "required": [
        "concentration_hhi",
        "turnover",
        "disposition_effect",
        "max_drawdown"
      ],
      "title": "ProcessMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete Feature 3 decision review output.",
  "properties": {
    "benchmark_replays": {
      "items": {
        "$ref": "#/$defs/BenchmarkReplay"
      },
      "title": "Benchmark Replays",
      "type": "array"
    },
    "disclaimer": {
      "title": "Disclaimer",
      "type": "string"
    },
    "institutional_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/InstitutionalMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "is_synthetic_demo": {
      "default": false,
      "title": "Is Synthetic Demo",
      "type": "boolean"
    },
    "parameters_used": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Parameters Used",
      "type": "object"
    },
    "portfolio": {
      "$ref": "#/$defs/Portfolio"
    },
    "portfolio_xirr": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Portfolio Xirr"
    },
    "process_metrics": {
      "$ref": "#/$defs/ProcessMetrics"
    },
    "review_text": {
      "title": "Review Text",
      "type": "string"
    },
    "synthetic_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Synthetic Label"
    }
  },
  "required": [
    "portfolio",
    "benchmark_replays",
    "process_metrics",
    "review_text",
    "disclaimer",
    "parameters_used"
  ],
  "title": "DecisionReview",
  "type": "object"
}
